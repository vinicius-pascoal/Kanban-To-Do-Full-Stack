// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                      @id @default(cuid())
  email                String                      @unique
  password             String?
  name                 String
  googleSub            String?                     @unique
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  teams                TeamMember[]
  cards                Card[]
  comments             Comment[]
  calendarIntegrations GoogleCalendarIntegration[]
  calendarEventLinks   CalendarEventLink[]
}

model Team {
  id        String       @id @default(cuid())
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  members   TeamMember[]
  boards    Board[]
}

model TeamMember {
  id        String   @id @default(cuid())
  userId    String
  teamId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // Perfil
  isOwner Boolean @default(false)

  // Permissões de Card
  canCreateCard Boolean @default(false)
  canEditCard   Boolean @default(false)
  canRemoveCard Boolean @default(false)

  // Permissões de Coluna
  canCreateColumn Boolean @default(false)
  canEditColumn   Boolean @default(false)
  canRemoveColumn Boolean @default(false)

  // Permissões de Time
  canAddMember    Boolean @default(false)
  canRemoveMember Boolean @default(false)
  canRenameTeam   Boolean @default(false)

  @@unique([userId, teamId])
}

model Board {
  id        String   @id @default(cuid())
  name      String
  teamId    String?
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  columns   Column[]
  tags      Tag[]
}

model Column {
  id          String  @id @default(cuid())
  name        String
  order       Int
  boardId     String
  board       Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  color       String?
  isCompleted Boolean @default(false)
  cards       Card[]
}

model Card {
  id                 String              @id @default(cuid())
  title              String
  description        String?
  priority           String
  dueDate            DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  columnId           String
  column             Column              @relation(fields: [columnId], references: [id], onDelete: Cascade)
  assignedToId       String?
  assignedTo         User?               @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  history            CardHistory[]
  comments           Comment[]
  tags               Tag[]
  order              Int                 @default(0)
  calendarEventLinks CalendarEventLink[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Tag {
  id      String @id @default(cuid())
  name    String
  color   String @default("#6366f1")
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards   Card[]
}

model CardHistory {
  id      String   @id @default(cuid())
  cardId  String
  card    Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  from    String
  to      String
  movedAt DateTime @default(now())
}

model GoogleCalendarIntegration {
  id                    String               @id @default(cuid())
  userId                String
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleSub             String?
  refreshTokenEncrypted String
  scope                 String?
  calendarId            String               @default("primary")
  status                GoogleCalendarStatus @default(CONNECTED)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  syncState             CalendarSyncState?
  eventLinks            CalendarEventLink[]

  @@unique([userId, calendarId])
}

model CalendarEventLink {
  id                          String                     @id @default(cuid())
  userId                      String
  cardId                      String
  boardId                     String?
  calendarId                  String
  eventId                     String
  etag                        String?
  updatedAt                   DateTime                   @updatedAt
  user                        User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  card                        Card                       @relation(fields: [cardId], references: [id], onDelete: Cascade)
  googleCalendarIntegration   GoogleCalendarIntegration? @relation(fields: [googleCalendarIntegrationId], references: [id])
  googleCalendarIntegrationId String?

  @@unique([userId, cardId])
  @@unique([calendarId, eventId])
}

model CalendarSyncState {
  id                String                    @id @default(cuid())
  integrationId     String                    @unique
  integration       GoogleCalendarIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  syncToken         String?
  channelId         String?
  resourceId        String?
  channelExpiration DateTime?
  updatedAt         DateTime                  @updatedAt
}

enum GoogleCalendarStatus {
  CONNECTED
  DISCONNECTED
}
